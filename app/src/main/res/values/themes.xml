<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base app theme: dark, no action bar, midnight gradient window -->
    <style name="Theme.Tutorial4" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_screen</item>
        <item name="android:statusBarColor">@color/bg_deep</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/mobile_accent</item>
        <item name="colorOnPrimary">@color/bg_deep</item>
        <item name="colorSecondaryContainer">@color/mobile_soft</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>
        <item name="colorSurface">@color/bg_deep</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">#59FFFFFF</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- One accent per app: inputs, toggles, sliders and buttons pick it up automatically -->
    <style name="Theme.Tutorial4.DataSet">
        <item name="colorPrimary">@color/dataset_accent</item>
        <item name="colorSecondaryContainer">@color/dataset_soft</item>
    </style>

    <style name="Theme.Tutorial4.Edible">
        <item name="colorPrimary">@color/edible_accent</item>
        <item name="colorSecondaryContainer">@color/edible_soft</item>
    </style>

    <style name="Theme.Tutorial4.Mobile">
        <item name="colorPrimary">@color/mobile_accent</item>
        <item name="colorSecondaryContainer">@color/mobile_soft</item>
    </style>

    <style name="Theme.Tutorial4.Price">
        <item name="colorPrimary">@color/price_accent</item>
        <item name="colorSecondaryContainer">@color/price_soft</item>
    </style>
</resources>
