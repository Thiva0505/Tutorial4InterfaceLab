<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== Typography ===== -->
    <style name="Text.Overline" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.22</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.HeroTitle" parent="">
        <item name="android:textSize">38sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.HeroSub" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#D9FFFFFF</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Text.HeroNumber" parent="">
        <item name="android:textSize">110sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">#22FFFFFF</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.Code" parent="">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#F2FFFFFF</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:background">@drawable/bg_code</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="Text.Section" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="Text.Body" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="Text.Mono" parent="">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingExtra">5dp</item>
    </style>

    <style name="Text.Hint" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="Text.Back" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- ===== Surfaces ===== -->
    <style name="GlassCard" parent="">
        <item name="android:background">@drawable/bg_glass</item>
        <item name="android:padding">18dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="StatTile" parent="">
        <item name="android:background">@drawable/bg_glass</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="Text.StatValue" parent="">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Text.StatLabel" parent="">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>

    <!-- ===== Inputs & buttons ===== -->
    <style name="Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>

    <style name="InputText" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_height">58dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:layout_marginTop">18dp</item>
    </style>

    <style name="Button.Ghost" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">52dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Toggle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">50dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- ===== Home menu cards ===== -->
    <style name="MenuCard" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">18dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="Text.MenuBadge" parent="">
        <item name="android:layout_width">54dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">#FFFFFFFF</item>
    </style>

    <style name="Text.MenuTitle" parent="">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.MenuSub" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <style name="Text.MenuChip" parent="">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">11sp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="Text.Arrow" parent="">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:paddingStart">8dp</item>
    </style>
</resources>
