<?xml version="1.0" encoding="utf-8"?>
<!-- 03 MOBILE: build a SmartPhone / BasicPhone and tune its RadioTuner -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MobileActivity">

    <View
        android:layout_width="380dp"
        android:layout_height="380dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-150dp"
        android:layout_marginEnd="-160dp"
        android:background="@drawable/glow_mobile" />

    <View
        android:layout_width="340dp"
        android:layout_height="340dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="-180dp"
        android:background="@drawable/glow_mobile" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="36dp">

            <TextView
                android:id="@+id/tvBack"
                style="@style/Text.Back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="‹  Home" />

            <!-- HERO -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_hero_mobile"
                android:elevation="8dp"
                android:padding="22dp">

                <TextView
                    style="@style/Text.HeroNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-18dp"
                    android:text="03" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Overline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Section B · Question 3"
                        android:textColor="#CCFFFFFF" />

                    <TextView
                        style="@style/Text.HeroTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Mobile" />

                    <TextView
                        style="@style/Text.HeroSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Every MobileDevice is a RadioTuner. Build a phone, then tune in." />

                    <TextView
                        style="@style/Text.Code"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="interface RadioTuner {\n    void setStation(String s);\n    void setFrequency(double f);\n}" />
                </LinearLayout>
            </FrameLayout>

            <!-- DEVICE -->
            <LinearLayout
                style="@style/GlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp">

                <TextView
                    style="@style/Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step 1 · Build the device" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleDevice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:checkedButton="@id/btnSmart"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <Button
                        android:id="@+id/btnSmart"
                        style="@style/Toggle"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="SmartPhone" />

                    <Button
                        android:id="@+id/btnBasic"
                        style="@style/Toggle"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="BasicPhone" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilManufacturer"
                        style="@style/Input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="Manufacturer">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etManufacturer"
                            style="@style/InputText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"
                            android:text="Samsung" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilModel"
                        style="@style/Input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:hint="Model">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etModel"
                            style="@style/InputText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapCharacters"
                            android:text="S20" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilType"
                    style="@style/Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Type (SmartPhone only)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etType"
                        style="@style/InputText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:text="Galaxy" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- RADIO -->
            <LinearLayout
                style="@style/GlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step 2 · Tune the radio" />

                <!-- Neon radio display -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_lcd"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.4"
                        android:text="● FM STEREO"
                        android:textColor="@color/mobile_accent"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvFrequency"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:includeFontPadding="false"
                            android:shadowColor="@color/mobile_start"
                            android:shadowDx="0"
                            android:shadowDy="0"
                            android:shadowRadius="28"
                            android:text="97.6"
                            android:textColor="@color/lcd_text"
                            android:textSize="60sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_marginBottom="8dp"
                            android:fontFamily="monospace"
                            android:text="MHz"
                            android:textColor="@color/mobile_accent"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStationLcd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.25"
                        android:text="HOT FM"
                        android:textAllCaps="true"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderFrequency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:stepSize="0.1"
                    android:value="97.6"
                    android:valueFrom="87.5"
                    android:valueTo="110.0"
                    app:labelBehavior="gone"
                    app:thumbColor="@color/lcd_text"
                    app:trackColorActive="@color/mobile_accent"
                    app:trackColorInactive="@color/glass_strong" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <TextView
                        style="@style/Text.Hint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="87.5" />

                    <TextView
                        style="@style/Text.Hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="110.0" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilStation"
                    style="@style/Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Station name">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etStation"
                        style="@style/InputText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:text="Hot FM" />
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/btnBuild"
                    style="@style/Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:text="Build &amp; tune device" />
            </LinearLayout>

            <!-- OUTPUT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_menu_mobile"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/Text.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="printDetails()"
                    android:textColor="@color/mobile_accent" />

                <TextView
                    android:id="@+id/tvDetails"
                    style="@style/Text.Mono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Build a device to see its details here." />
            </LinearLayout>

            <Button
                android:id="@+id/btnDemo"
                style="@style/Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="Run tutorial demo (S20 &amp; Walkman)" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
