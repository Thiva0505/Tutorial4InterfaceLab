<?xml version="1.0" encoding="utf-8"?>
<!-- 02 EDIBLE: a Person eats any Edible (Animal, Apple, Orange) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".EdibleActivity">

    <View
        android:layout_width="360dp"
        android:layout_height="360dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-160dp"
        android:layout_marginTop="-130dp"
        android:background="@drawable/glow_edible" />

    <View
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-150dp"
        android:layout_marginBottom="-80dp"
        android:background="@drawable/glow_edible" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="36dp">

            <TextView
                android:id="@+id/tvBack"
                style="@style/Text.Back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="‹  Home" />

            <!-- HERO -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_hero_edible"
                android:elevation="8dp"
                android:padding="22dp">

                <TextView
                    style="@style/Text.HeroNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-18dp"
                    android:text="02" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Overline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Section B · Question 2"
                        android:textColor="#CCFFFFFF" />

                    <TextView
                        style="@style/Text.HeroTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Edible" />

                    <TextView
                        style="@style/Text.HeroSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="A chicken and an apple share nothing, except that both are Edible. Pick a food and see how it is eaten." />

                    <TextView
                        style="@style/Text.Code"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="interface Edible {\n    String howToEat();\n}" />
                </LinearLayout>
            </FrameLayout>

            <!-- WHO -->
            <LinearLayout
                style="@style/GlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp">

                <TextView
                    style="@style/Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step 1 · Who is eating?" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPerson"
                    style="@style/Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:hint="Person's name">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPerson"
                        style="@style/InputText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName|textCapWords"
                        android:text="Ali" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- WHAT -->
            <LinearLayout
                style="@style/GlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step 2 · Pick something edible" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleFood"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:checkedButton="@id/btnAnimal"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <Button
                        android:id="@+id/btnAnimal"
                        style="@style/Toggle"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="Animal" />

                    <Button
                        android:id="@+id/btnApple"
                        style="@style/Toggle"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="Apple" />

                    <Button
                        android:id="@+id/btnOrange"
                        style="@style/Toggle"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="Orange" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilFood"
                    style="@style/Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Food name">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etFood"
                        style="@style/InputText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:text="Chicken" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvClassChain"
                    style="@style/Text.MenuChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_chip_edible"
                    android:text="class Animal implements Edible"
                    android:textColor="@color/edible_accent" />

                <Button
                    android:id="@+id/btnEat"
                    style="@style/Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:text="Eat it" />
            </LinearLayout>

            <!-- RESULT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_menu_edible"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/Text.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="person.eating(food)"
                    android:textColor="@color/edible_accent" />

                <TextView
                    android:id="@+id/tvResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingExtra="5dp"
                    android:text="Tap “Eat it” to see how the food is eaten."
                    android:textColor="@color/text_primary"
                    android:textSize="20sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnDemo"
                style="@style/Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="Run tutorial demo (Ali &amp; Sarah)" />

            <!-- HISTORY -->
            <LinearLayout
                style="@style/GlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Meal history" />

                <TextView
                    android:id="@+id/tvHistory"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nothing eaten yet."
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
