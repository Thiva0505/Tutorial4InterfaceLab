<?xml version="1.0" encoding="utf-8"?>
<!-- 04 PRICE: can a Customer afford a SmartPhone / Laptop / Car? -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PriceActivity">

    <View
        android:layout_width="360dp"
        android:layout_height="360dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-140dp"
        android:layout_marginEnd="-150dp"
        android:background="@drawable/glow_price" />

    <View
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-160dp"
        android:layout_marginBottom="-90dp"
        android:background="@drawable/glow_price" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="36dp">

            <TextView
                android:id="@+id/tvBack"
                style="@style/Text.Back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="‹  Home" />

            <!-- HERO -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_hero_price"
                android:elevation="8dp"
                android:padding="22dp">

                <TextView
                    style="@style/Text.HeroNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-18dp"
                    android:text="04" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Overline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Section B · Question 4"
                        android:textColor="#CCFFFFFF" />

                    <TextView
                        style="@style/Text.HeroTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Price" />

                    <TextView
                        style="@style/Text.HeroSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Phones, laptops and cars all have a Price. Check if a customer's salary is enough." />

                    <TextView
                        style="@style/Text.Code"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="interface Price {\n    void getPrice(Customer c);\n}" />
                </LinearLayout>
            </FrameLayout>

            <!-- ITEM -->
            <LinearLayout
                style="@style/GlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp">

                <TextView
                    style="@style/Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step 1 · What are they buying?" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:checkedButton="@id/btnPhone"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <Button
                        android:id="@+id/btnPhone"
                        style="@style/Toggle"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="Phone" />

                    <Button
                        android:id="@+id/btnLaptop"
                        style="@style/Toggle"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="Laptop" />

                    <Button
                        android:id="@+id/btnCar"
                        style="@style/Toggle"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="Car" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilItemName"
                    style="@style/Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Phone model">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etItemName"
                        style="@style/InputText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:text="Iphone 14 ProMax" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilItemPrice"
                    style="@style/Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Price"
                    app:prefixText="RM ">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etItemPrice"
                        style="@style/InputText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:text="5500" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvRule"
                    style="@style/Text.MenuChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_chip_price"
                    android:text="Rule: salary &gt; RM4000"
                    android:textColor="@color/price_accent" />
            </LinearLayout>

            <!-- CUSTOMER -->
            <LinearLayout
                style="@style/GlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Step 2 · Who is the customer?" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCustomer"
                    style="@style/Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:hint="Customer name">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCustomer"
                        style="@style/InputText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName|textCapWords"
                        android:text="Sally" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSalary"
                    style="@style/Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Monthly salary"
                    app:prefixText="RM ">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSalary"
                        style="@style/InputText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:text="3000" />
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/btnCheck"
                    style="@style/Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:text="Can they buy it?" />
            </LinearLayout>

            <!-- VERDICT -->
            <LinearLayout
                android:id="@+id/cardVerdict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_glass"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvVerdictIcon"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_badge_price"
                        android:gravity="center"
                        android:text="?"
                        android:textColor="#FFFFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.StatLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="0dp"
                            android:text="Verdict" />

                        <TextView
                            android:id="@+id/tvVerdict"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="Waiting…"
                            android:textColor="@color/text_primary"
                            android:textSize="26sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvItemLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Fill in the item and customer, then tap the button."
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvVerdictDetail"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnDemo"
                style="@style/Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="Run tutorial demo (Sally, Aaron, Simon)" />

            <LinearLayout
                style="@style/GlassCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    style="@style/Text.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Checkout log" />

                <TextView
                    android:id="@+id/tvHistory"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No checks yet."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
