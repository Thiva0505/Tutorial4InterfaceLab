<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tutorial4">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DataSetActivity"
            android:theme="@style/Theme.Tutorial4.DataSet"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".EdibleActivity"
            android:theme="@style/Theme.Tutorial4.Edible"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MobileActivity"
            android:theme="@style/Theme.Tutorial4.Mobile"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".PriceActivity"
            android:theme="@style/Theme.Tutorial4.Price"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
